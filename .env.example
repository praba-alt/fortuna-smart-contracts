# Local Hardhat RPC (optional; default is shown)
LOCALHOST_RPC_URL=http://127.0.0.1:8545
# Deterministic local wallets (12-word mnemonic)
LOCAL_MNEMONIC=test test test test test test test test test test test junk
LOCAL_HD_PATH=m/44'/60'/0'/0
LOCAL_ACCOUNT_COUNT=20
LOCAL_INITIAL_BALANCE_WEI=10000000000000000000000

# Optional local wallet generation target balance
LOCAL_WALLET_COUNT=3
LOCAL_WALLET_AMOUNT_ETH=10

# Base RPC endpoints
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Deployment wallet (Base)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Deploy / verify constructor parameters
TREASURY_WALLET=0x0000000000000000000000000000000000000000
FLAT_FEE_NATIVE=0.01
TOKEN_FEE_BPS=25
TOKEN_RECIPIENT=0x0000000000000000000000000000000000000000
TOKEN_INITIAL_OWNER=0x0000000000000000000000000000000000000000

# Verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
